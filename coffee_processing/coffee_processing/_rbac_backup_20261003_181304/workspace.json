  "content": "[{\"id\":\"cp-header\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>إدارة ومعالجة البن</b></span>\",\"col\":12}},{\"id\":\"cp-intro\",\"type\":\"paragraph\",\"data\":{\"text\":\"لوحة تشغيل متكاملة لدورة البن: الاستلام، الفرز، التخمير، التجفيف، التقشير، التصنيف، التذوق، الخلط والتعبئة مع تتبع الدفعات والتكلفة والجودة.\",\"col\":12}},{\"id\":\"cp-ops\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>العمليات اليومية</b></span>\",\"col\":12}},{\"id\":\"op-0\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"استلام البن\",\"col\":3}},{\"id\":\"op-1\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"الفرز\",\"col\":3}},{\"id\":\"op-2\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"التخمير\",\"col\":3}},{\"id\":\"op-3\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"التجفيف\",\"col\":3}},{\"id\":\"op-4\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"التقشير وخدمة الغير\",\"col\":3}},{\"id\":\"op-5\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"التصنيف والتنقية\",\"col\":3}},{\"id\":\"op-6\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"التذوق والتقييم\",\"col\":3}},{\"id\":\"op-7\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"الخلط\",\"col\":3}},{\"id\":\"op-8\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"التعبئة\",\"col\":3}},{\"id\":\"cp-flow\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>الدورة الرئيسية</b></span>\",\"col\":12}},{\"id\":\"cp-flow-text\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>الشراء والاستلام</b> ← <b>الفرز</b> ← <b>التخمير</b> ← <b>التجفيف</b> ← <b>التقشير</b> ← <b>التصنيف</b> ← <b>التذوق</b> ← <b>الخلط</b> ← <b>التعبئة</b> ← <b>البيع\",\"col\":12}},{\"id\":\"cp-batches\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>الدفعات والتتبع</b></span>\",\"col\":12}},{\"id\":\"b-0\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"دفعات البن\",\"col\":3}},{\"id\":\"b-1\",\"type\":\"shortcut\",\"data\":{\