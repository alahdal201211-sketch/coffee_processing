{
    "doctype": "DocType",
    "name": "Coffee Daily Monitoring",
    "module": "Coffee Processing",
    "engine": "InnoDB",
    "istable": 1,
    "field_order": ["monitoring_date", "temperature", "humidity", "weight", "moisture", "state", "measurement", "drying_method", "performed_by"],
    "fields": [
        {"fieldname": "monitoring_date", "fieldtype": "Date", "label": "تاريخ المراقبة", "reqd": 1, "in_list_view": 1},
        {"fieldname": "temperature", "fieldtype": "Float", "label": "درجة الحرارة", "in_list_view": 1},
        {"fieldname": "humidity", "fieldtype": "Float", "label": "الرطوبة", "in_list_view": 1},
        {"fieldname": "weight", "fieldtype": "Float", "label": "الوزن", "in_list_view": 1},
        {"fieldname": "moisture", "fieldtype": "Float", "label": "الرطوبة %", "in_list_view": 1},
        {"fieldname": "state", "fieldtype": "Select", "label": "الحالة", "options": "\nNormal\nWarning\nCritical"},
        {"fieldname": "measurement", "fieldtype": "Data", "label": "القياس"},
        {"fieldname": "drying_method", "fieldtype": "Data", "label": "طريقة التجفيف"},
        {"fieldname": "performed_by", "fieldtype": "Link", "label": "نفذ بواسطة", "options": "User"}
    ]
}
