# -*- coding: utf-8 -*-

import frappe
from frappe import _
from frappe.model.document import Document
from frappe.utils import flt


def on_purchase_receipt_submit(doc, method=None):
    """
    إنشاء Coffee Batch تلقائياً بعد Submit لـ Purchase Receipt.

    Purchase Receipt هو المسؤول عن حركة المخزون.
    هذه الخدمة تنشئ طبقة Coffee Batch والتتبع فقط،
    ولا تنشئ Stock Entry إضافياً.
    """

    if not doc or doc.docstatus != 1:
        return

    for row in doc.items:

        if not row.item_code:
            continue

        # لا ننشئ Coffee Batch إلا للأصناف المخزنية
        # التي تستخدم Batch Tracking.
        item_data = frappe.db.get_value(
            "Item",
            row.item_code,
            [
                "item_name",
                "is_stock_item",
                "has_batch_no",
                "is_purchase_item",
            ],
            as_dict=True,
        )

        if not item_data:
            continue

        if not item_data.is_stock_item:
            continue

        if not item_data.has_batch_no:
            continue

        if not item_data.is_purchase_item:
            continue

        # الكمية المقبولة فعلياً من Purchase Receipt Item
        qty = flt(row.qty)

        if qty <= 0:
            continue

        # الحصول على ERPNext Batches التي أنشأها
        # Serial and Batch Bundle لهذا السطر.
        batch_entries = _get_batch_entries(row)

        if not batch_entries:
            # لا ننشئ Coffee Batch بدون ERPNext Batch.
            # هذا يحمي التتبع من إنشاء دفعة غير مرتبطة بالمخزون.
            continue

        for entry in batch_entries:

            erpnext_batch = entry.get("batch_no")
            batch_qty = flt(entry.get("qty"))

            if not erpnext_batch or batch_qty <= 0:
                continue

            _ensure_coffee_batch(
                doc=doc,
                row=row,
                item_data=item_data,
                erpnext_batch=erpnext_batch,
                batch_qty=batch_qty,
            )


def _get_batch_entries(row):
    """
    قراءة Batches من Serial and Batch Bundle
    الخاص بـ Purchase Receipt Item.
    """

    bundle_name = getattr(row, "serial_and_batch_bundle", None)

    if not bundle_name:
        return []

    return frappe.get_all(
        "Serial and Batch Entry",
        filters={
            "parent": bundle_name,
            "parenttype": "Serial and Batch Bundle",
        },
        fields=[
            "batch_no",
            "qty",
        ],
        order_by="idx asc",
    )


def _ensure_coffee_batch(
    doc,
    row,
    item_data,
    erpnext_batch,
    batch_qty,
):
    """
    إنشاء Coffee Batch واحد لكل ERPNext Batch.

    Idempotent:
    إعادة التنفيذ لا تنشئ Batch مكرر.
    """

    existing = frappe.db.get_value(
        "Coffee Batch",
        {
            "purchase_receipt": doc.name,
            "custom_item_code": row.item_code,
            "supplier": doc.supplier,
            "company": doc.company,
            "erpnext_batch": erpnext_batch,
        },
        "name",
    )

    if existing:
        _ensure_purchase_source(
            existing,
            doc,
            row,
            erpnext_batch,
            batch_qty,
        )
        return existing

    # محاولة الحصول على الفرع من Purchase Receipt.
    branch = (
        getattr(doc, "branch", None)
        or getattr(row, "branch", None)
    )

    # سعر السطر هو المصدر الأساسي.
    rate = flt(row.rate)

    if rate <= 0:
        rate = flt(doc.get("grand_total")) / flt(doc.get("total_qty") or 1)

    batch = frappe.new_doc("Coffee Batch")

    batch.custom_item_code = row.item_code

    batch.item_name = (
        item_data.item_name
        or row.item_code
    )

    batch.coffee_type = _get_coffee_type(row.item_code)

    batch.company = doc.company

    if branch:
        batch.branch = branch

    batch.source_type = "Purchase"

    batch.supplier = doc.supplier
    batch.purchase_receipt = doc.name

    # المستودع الفعلي الذي استلم إليه السطر
    batch.current_warehouse = row.warehouse

    batch.qty = batch_qty

    batch.valuation_rate = rate
    batch.cost_per_kg = rate

    batch.total_value = batch_qty * rate

    batch.erpnext_batch = erpnext_batch

    batch.status = "Received"

    # Cost Center إذا كان موجوداً
    cost_center = (
        getattr(row, "cost_center", None)
        or getattr(doc, "cost_center", None)
    )

    if cost_center:
        batch.cost_center = cost_center

    batch.insert(ignore_permissions=True)

    _ensure_purchase_source(
        batch.name,
        doc,
        row,
        erpnext_batch,
        batch_qty,
    )

    return batch.name


def _ensure_purchase_source(
    coffee_batch_name,
    doc,
    row,
    erpnext_batch,
    batch_qty,
):
    """
    إضافة مصدر الشراء إلى Coffee Batch مرة واحدة فقط.
    """

    batch = frappe.get_doc(
        "Coffee Batch",
        coffee_batch_name,
    )

    for source in batch.get("purchase_sources") or []:

        if (
            source.purchase_receipt == doc.name
            and source.purchase_receipt_item == row.name
            and source.erpnext_batch == erpnext_batch
        ):
            return

    source = batch.append(
        "purchase_sources",
        {},
    )

    source.purchase_receipt = doc.name
    source.purchase_receipt_item = row.name

    # نستخدم Purchase Invoice المرتبط إن وجد.
    purchase_invoice = _get_purchase_invoice(
        doc.name
    )

    if purchase_invoice:
        source.purchase_invoice = purchase_invoice

    source.supplier = doc.supplier
    source.item = row.item_code
    source.qty = batch_qty
    source.rate = flt(row.rate)

    source.amount = (
        flt(batch_qty) *
        flt(row.rate)
    )

    source.erpnext_batch = erpnext_batch

    batch.save(ignore_permissions=True)


def _get_purchase_invoice(purchase_receipt):
    """
    الحصول على Purchase Invoice المرتبط،
    إن كان موجوداً.
    """

    result = frappe.db.sql(
        """
        SELECT parent
        FROM `tabPurchase Invoice Item`
        WHERE purchase_receipt = %s
          AND docstatus = 1
        ORDER BY creation DESC
        LIMIT 1
        """,
        (purchase_receipt,),
        as_dict=True,
    )

    return result[0].parent if result else None


def _get_coffee_type(item_code):
    """
    تحديد نوع البن من الحقول المخصصة للصنف إن وجدت.
    وإلا Commercial كقيمة آمنة.
    """

    meta = frappe.get_meta("Item")

    for fieldname in (
        "coffee_type",
        "custom_coffee_type",
    ):
        if meta.has_field(fieldname):
            value = frappe.db.get_value(
                "Item",
                item_code,
                fieldname,
            )

            if value:
                return value

    return "Commercial"


def on_purchase_receipt_cancel(doc, method=None):
    """
    عند إلغاء Purchase Receipt:
    نلغي Coffee Batches التي نشأت من هذا الإيصال
    فقط إذا لم تدخل في معالجة لاحقة.
    """

    if not doc:
        return

    batches = frappe.get_all(
        "Coffee Batch",
        filters={
            "purchase_receipt": doc.name,
            "source_type": "Purchase",
        },
        fields=[
            "name",
            "qty",
            "status",
        ],
    )

    for batch_row in batches:

        batch = frappe.get_doc(
            "Coffee Batch",
            batch_row.name,
        )

        # إذا كانت الدفعة دخلت معالجة فعلية فلا نعبث
        # بسجل التتبع هنا.
        processed_statuses = {
            "Processing",
            "Processed",
            "Completed",
            "Graded",
            "In Progress",
        }

        if batch.status in processed_statuses:
            continue

        batch.status = "Cancelled"
        batch.qty = 0
        batch.total_value = 0

        batch.save(ignore_permissions=True)


@frappe.whitelist()
def create_coffee_batches_from_purchase_receipt(purchase_receipt):
    """
    أداة آمنة لإعادة مزامنة Purchase Receipt منشور
    إذا كان موجوداً قبل تفعيل الأتمتة.

    لا تنشئ Stock Entry.
    ولا تنشئ Batch مكرر.
    """

    doc = frappe.get_doc(
        "Purchase Receipt",
        purchase_receipt,
    )

    if doc.docstatus != 1:
        frappe.throw(
            _("يجب أن يكون Purchase Receipt منشوراً.")
        )

    on_purchase_receipt_submit(doc)

    return {
        "success": True,
        "purchase_receipt": doc.name,
    }
