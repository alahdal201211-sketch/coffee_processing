  {
   "fieldname": "section_audit",
   "fieldtype": "Section Break",
   "label": "التدقيق",
   "collapsible": 1
  },
  {
   "fieldname": "created_by",
   "fieldtype": "Link",
   "label": "أنشئ بواسطة",
   "options": "User",
   "read_only": 1,
   "default": "__user"
  },
  {
   "fieldname": "creation_date",
   "fieldtype": "Date",
   "label": "تاريخ الإنشاء",
   "read_only": 1,
   "default": "Today"
