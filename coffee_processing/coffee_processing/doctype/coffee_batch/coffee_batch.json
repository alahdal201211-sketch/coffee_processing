  {
   "fieldname": "column_break_6",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_quality_inspection",
   "fieldtype": "Link",
   "label": "آخر فحص جودة",
   "options": "Quality Inspection",
   "read_only": 1
