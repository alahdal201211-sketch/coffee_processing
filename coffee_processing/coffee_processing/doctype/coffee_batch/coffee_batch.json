  {
   "fieldname": "notes",
   "fieldtype": "Text Editor",
   "label": "ملاحظات"
  },
  {
   "fieldname": "erpnext_batch",
   "fieldtype": "Link",
   "label": "دفعة المخزون ERPNext",
   "options": "Batch",
   "read_only": 1,
   "in_standard_filter": 1
