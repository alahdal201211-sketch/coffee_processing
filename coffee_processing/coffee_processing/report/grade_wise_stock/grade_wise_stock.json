{
    "doctype": "Report",
    "report_name": "Grade-wise Stock Report",
    "ref_doctype": "Coffee Batch",
    "report_type": "Query Report",
    "is_standard": "Yes",
    "module": "Coffee Processing",
    "query": "SELECT cb.coffee_type, cb.coffee_grade, cb.custom_item_code, cb.item_name, cb.company, cb.branch, cb.current_warehouse, cb.qty, cb.total_value, cb.cost_per_kg FROM `tabCoffee Batch` cb WHERE cb.is_grade_batch = 1 AND cb.qty > 0 ORDER BY cb.coffee_type, cb.coffee_grade",
    "columns": [
        {
            "label": "Coffee Type",
            "fieldname": "coffee_type",
            "fieldtype": "Data",
            "width": 120
        },
        {
            "label": "Grade",
            "fieldname": "coffee_grade",
            "fieldtype": "Link",
            "options": "Coffee Grade Master",
            "width": 120
        },
        {
            "label": "Item Code",
            "fieldname": "custom_item_code",
            "fieldtype": "Data",
            "width": 150
        },
        {
            "label": "Item Name",
            "fieldname": "item_name",
            "fieldtype": "Data",
            "width": 150
        },
        {
            "label": "Company",
            "fieldname": "company",
            "fieldtype": "Link",
            "options": "Company",
            "width": 120
        },
        {
            "label": "Branch",
            "fieldname": "branch",
            "fieldtype": "Link",
            "options": "Branch",
            "width": 100
        },
        {
            "label": "Warehouse",
            "fieldname": "current_warehouse",
            "fieldtype": "Link",
            "options": "Warehouse",
            "width": 150
        },
        {
            "label": "Qty (KG)",
            "fieldname": "qty",
            "fieldtype": "Float",
            "width": 100
        },
        {
            "label": "Value",
            "fieldname": "total_value",
            "fieldtype": "Currency",
            "width": 120
        },
        {
            "label": "Cost/KG",
            "fieldname": "cost_per_kg",
            "fieldtype": "Currency",
            "width": 100
        }
    ],
    "name": "Grade-wise Stock Report"
}
