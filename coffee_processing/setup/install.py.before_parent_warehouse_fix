def ensure_bank_and_wallet_accounts():
    """Create generic YER/SAR/USD bank and wallet ledgers without inventing institutions."""
    company = "الاهدل للبن"
    # Parent groups are deliberately generic so the user can rename/add actual banks later.
    parents = [
        ("حسابات بنكية متعددة العملات - ALC", "حسابات مصرفية - ALC", "Asset"),
        ("محافظ إلكترونية متعددة العملات - ALC", "أصول متداولة - ALC", "Asset"),
    ]
    for name, parent, root in parents:
        if not frappe.db.exists("Account", name):
            d = frappe.get_doc({"doctype":"Account","account_name":name.replace(" - ALC", ""),
                "company":company,"root_type":root,"report_type":"Balance Sheet",
                "is_group":1,"parent_account":parent})
            d.insert(ignore_permissions=True)
    rows=[]
    for kind, parent in [("بنك", "حسابات بنكية متعددة العملات - ALC"),("محفظة إلكترونية", "محافظ إلكترونية متعددة العملات - ALC")]:
        for cur in ("YER","SAR","USD"):
            name=f"{kind} {cur} - ALC"
            rows.append((name, kind, cur, parent))
    for name, kind, cur, parent in rows:
        if frappe.db.exists("Account", name):
            continue
        d=frappe.get_doc({"doctype":"Account","account_name":name.replace(" - ALC", ""),
            "company":company,"root_type":"Asset","report_type":"Balance Sheet","is_group":0,
            "account_currency":cur,"parent_account":parent,
            "account_type":"Bank" if kind=="بنك" else "Cash"})
        d.insert(ignore_permissions=True)


def ensure_process_cost_links():
    """Link each configured operation to the matching cost center/account when available."""
    company="الاهدل للبن"
    mapping={
      "RECEIVING":"استلام البن - البن - ALC - ALC",
      "SORTING":"الفرز - البن - ALC - ALC",
      "FERMENTATION":"التخمير - البن - ALC - ALC",
      "DRYING":"التجفيف - البن - ALC - ALC",
      "HULLING":"التقشير - البن - ALC - ALC",
      "GRADING":"التصنيف - البن - ALC - ALC",
      "CUPPING":"التذوق والتقييم - البن - ALC - ALC",
      "PACKAGING":"التعبئة - البن - ALC - ALC",
      "BLENDING":"الخلط - البن - ALC - ALC",
    }
    for op, cc in mapping.items():
        if not frappe.db.exists("Coffee Operation Master", op):
            continue
        doc=frappe.get_doc("Coffee Operation Master",op)
        if not doc.default_cost_center and frappe.db.exists("Cost Center",cc):
            doc.default_cost_center=cc; doc.save(ignore_permissions=True)


def install_master_data():
    """
    Install the complete Coffee Processing master data.

    This function is intentionally idempotent.
    It can safely be executed more than once.
    """

    frappe.flags.in_coffee_master_install = True

    try:
        ensure_uoms()
        ensure_company()
        ensure_currencies()
        ensure_item_groups()
        ensure_accounts()
        ensure_warehouses()
        ensure_cost_centers()
        ensure_items()
        ensure_supplier_fields()
        ensure_supplier_regions()
        ensure_roles()
        ensure_bank_and_wallet_accounts()
        update_company_defaults()
        ensure_process_cost_links()

        frappe.db.commit()

    except Exception:
        frappe.db.rollback()
        raise

    finally:
        frappe.flags.in_coffee_master_install = False


def after_install():
    install_master_data()
